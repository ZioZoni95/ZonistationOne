#!/bin/bash

# ZoniStationOne configure script

echo "Configuring ZoniStationOne..."

# Default values
CC=${CC:-gcc}
CFLAGS=${CFLAGS:-"-Wall -Wextra -std=c99 -O2 -g"}
LDFLAGS=${LDFLAGS:-""}
LIBS=${LIBS:-"-lm"}

# Check for SDL2
SDL2_CFLAGS=""
SDL2_LIBS=""
if pkg-config --exists sdl2; then
    SDL2_CFLAGS=$(pkg-config --cflags sdl2)
    SDL2_LIBS=$(pkg-config --libs sdl2)
    echo "Found SDL2"
else
    echo "Warning: SDL2 not found, frontend will be limited"
fi

# Check for OpenGL
OPENGL_LIBS=""
if pkg-config --exists gl; then
    OPENGL_LIBS=$(pkg-config --libs gl)
    echo "Found OpenGL"
else
    # Try system-specific OpenGL
    if [ "$(uname)" = "Linux" ]; then
        OPENGL_LIBS="-lGL -lGLU"
        echo "Using system OpenGL"
    else
        echo "Warning: OpenGL not found, GPU plugins will be limited"
    fi
fi

# Check for pthread
PTHREAD_LIBS=""
if [ "$(uname)" = "Linux" ]; then
    PTHREAD_LIBS="-lpthread"
    echo "Using pthread"
fi

# Generate config.mak
cat > config.mak << EOF
# Generated by configure script
CC = $CC
CFLAGS = $CFLAGS
LDFLAGS = $LDFLAGS
LIBS = $LIBS $SDL2_LIBS $OPENGL_LIBS $PTHREAD_LIBS
SDL2_CFLAGS = $SDL2_CFLAGS
SDL2_LIBS = $SDL2_LIBS
OPENGL_LIBS = $OPENGL_LIBS
PTHREAD_LIBS = $PTHREAD_LIBS

# Features
HAVE_SDL2 = $(if [ -n "$SDL2_LIBS" ]; then echo "1"; else echo "0"; fi)
HAVE_OPENGL = $(if [ -n "$OPENGL_LIBS" ]; then echo "1"; else echo "0"; fi)
HAVE_PTHREAD = $(if [ -n "$PTHREAD_LIBS" ]; then echo "1"; else echo "0"; fi)

# Platform
PLATFORM = $(uname)
ARCH = $(uname -m)

# Version
VERSION = 0.1.0
EOF

echo "Configuration complete. Run 'make' to build." 